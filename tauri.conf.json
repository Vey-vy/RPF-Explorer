
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RPF Explorer",
  "version": "0.1.0",
  "identifier": "com.rpfexplorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RPF Explorer",
        "width": 1100,
        "height": 500,
        "minWidth": 740,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' blob: ipc: http://ipc.localhost https://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "RPF Explorer",
    "longDescription": "RPF Explorer - Desktop application",
    "category": "Utility",
    "publisher": "RPF Explorer",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}